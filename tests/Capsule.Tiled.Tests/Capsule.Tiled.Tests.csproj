<Project Sdk="Microsoft.NET.Sdk">

  <!-- The project imports scenes like a game's logic library. Its Assets/Scenes maps ship beside
       the test binary through the module's own targets.

       CapsuleAssetSourcesDir is explicit for a pinned release whose default looks a directory
       above the project. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.Tiled.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CapsuleImportScenes>true</CapsuleImportScenes>
    <CapsuleAssetSourcesDir>Assets</CapsuleAssetSourcesDir>
    <CapsuleTileSize>16</CapsuleTileSize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(CapsuleSourceRoot)' == ''">
    <PackageReference Include="JAG.Capsule" Version="[$(CapsuleVersion)]" />
    <PackageReference Include="JAG.Capsule.Build" Version="[$(CapsuleVersion)]" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(CapsuleSourceRoot)' != ''">
    <ProjectReference Include="$(CapsuleSourceRoot)/src/Capsule.Scenes/Capsule.Scenes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Capsule.Tiled/Capsule.Tiled.csproj" />
  </ItemGroup>

  <!-- The importer resolves paths relative to its inputs. Fixtures keep their layout in the output. -->
  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The shipped property types, copied into Fixtures/ beside the maps. -->
  <ItemGroup>
    <None Include="../../build/capsule.tiled-project;../../build/capsule-property-types.json"
          Link="Fixtures/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The seed spec builds a scratch tree with this repository's targets and build mode. -->
  <ItemGroup>
    <AssemblyMetadata Include="RepositoryRoot" Value="$(MSBuildThisFileDirectory)../.." />
    <AssemblyMetadata Include="CapsuleUsePackages" Value="$(CapsuleUsePackages)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
