<Project Sdk="Microsoft.NET.Sdk">

  <!-- Two kinds of spec: the importer driven directly over fixture maps, and the build integration
       — this project imports scenes like a game's logic library, so its own Assets/Scenes maps
       must arrive at assets/scenes/<key>.scene.json beside the test binary through the seam the
       package hooks, in source mode and in package mode alike.

       CapsuleAssetSourcesDir is named although it now matches Capsule's default: the pinned
       release the package-mode lane builds against still looks a directory above the project. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.Tiled.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CapsuleImportScenes>true</CapsuleImportScenes>
    <CapsuleAssetSourcesDir>Assets</CapsuleAssetSourcesDir>
    <CapsuleTileSize>16</CapsuleTileSize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(CapsuleSourceRoot)' == ''">
    <PackageReference Include="JAG.Capsule" Version="[$(CapsuleVersion)]" />
    <PackageReference Include="JAG.Capsule.Build" Version="[$(CapsuleVersion)]" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(CapsuleSourceRoot)' != ''">
    <ProjectReference Include="$(CapsuleSourceRoot)/src/Capsule.Scenes/Capsule.Scenes.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Capsule.Tiled/Capsule.Tiled.csproj" />
  </ItemGroup>

  <!-- The importer resolves paths relative to its inputs, so the fixture maps, their tileset and
       the golden document sit beside each other in the test output. -->
  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The shipped property types, read back by the specs that hold them to the names the importer
       reads. Flattened into Fixtures/ so they sit beside the maps the rest of the suite uses. -->
  <ItemGroup>
    <None Include="../../build/capsule.tiled-project;../../build/capsule-property-types.json"
          Link="Fixtures/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The seed spec drives this project's own targets over a scratch authoring tree, so it
       needs the repository and the mode this assembly was built in. -->
  <ItemGroup>
    <AssemblyMetadata Include="RepositoryRoot" Value="$(MSBuildThisFileDirectory)../.." />
    <AssemblyMetadata Include="CapsuleUsePackages" Value="$(CapsuleUsePackages)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
