<Project Sdk="Microsoft.NET.Sdk">

  <!-- The project imports scenes like a game's logic library. Its build project adds the importer,
       and its Assets/Scenes maps ship beside the test binary.

       CapsuleAssetSourcesDir is explicit for a pinned release whose default looks a directory
       above the project. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>JAG.Capsule.Tiled.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CapsuleBuildAssets>true</CapsuleBuildAssets>
    <CapsuleAssetSourcesDir>Assets</CapsuleAssetSourcesDir>
    <CapsuleBuildProject>../JAG.Capsule.Tiled.Build/JAG.Capsule.Tiled.Build.csproj</CapsuleBuildProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JAG.Capsule" Version="[0.10.0]" />
    <ProjectReference Include="../../src/JAG.Capsule.Tiled/JAG.Capsule.Tiled.csproj" />
  </ItemGroup>

  <!-- The importer resolves paths relative to its inputs. Fixtures keep their layout in the output. -->
  <ItemGroup>
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The shipped property types, copied into Fixtures/ beside the maps. -->
  <ItemGroup>
    <None Include="../../src/JAG.Capsule.Tiled/capsule.tiled-project;../../src/JAG.Capsule.Tiled/capsule-property-types.json"
          Link="Fixtures/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The shipping spec builds this project again, from the engine this build used. -->
  <ItemGroup>
    <AssemblyMetadata Include="RepositoryRoot" Value="$(MSBuildThisFileDirectory)../.." />
    <AssemblyMetadata Include="CapsuleSourcePath" Value="$(CapsuleSourcePath)" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
