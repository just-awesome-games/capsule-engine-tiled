<Project>

  <!-- A game consuming Capsule and this module from packages, and nothing else: the shape the
       README's quick start describes. Inside this repository it restores JAG.Capsule.Tiled from
       the tree's own pack (artifacts/packages, version 0.0.0) and Capsule from NuGet.org, so CI
       proves the packed targets and tool drive a real shell before a release carries them. A copy
       of this sample outside the repository sets both pins to real releases. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <CapsuleVersion>0.5.2</CapsuleVersion>
    <CapsuleTiledVersion>0.0.0</CapsuleTiledVersion>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JAG.Capsule.Build" Version="[$(CapsuleVersion)]" PrivateAssets="all" />
    <PackageReference Include="JAG.Capsule.Tiled" Version="[$(CapsuleTiledVersion)]" PrivateAssets="all" />
  </ItemGroup>

</Project>
