<Project>

  <!-- Tiled scene authoring for a Capsule game: every *.tmj under the game's scene sources becomes
       a *.scene.json under obj/, handed to Capsule's scene-document hook. Inert unless
       CapsuleImportScenes is true, and it defines no property of its own.

       Everything reading a Capsule property must happen inside a target: NuGet imports this file
       before JAG.Capsule.Build's targets, so CapsuleImportScenes and CapsuleAssetSourcesDir are
       not final at evaluation time. The hand-over is BeforeTargets for the same reason. -->

  <PropertyGroup>
    <CapsuleTiledToolProject Condition="'$(CapsuleTiledToolProject)' == '' and Exists('$(MSBuildThisFileDirectory)../src/Capsule.Tiled/Capsule.Tiled.csproj')">$(MSBuildThisFileDirectory)../src/Capsule.Tiled/Capsule.Tiled.csproj</CapsuleTiledToolProject>
    <CapsuleTiledToolAssembly Condition="'$(CapsuleTiledToolAssembly)' == '' and Exists('$(MSBuildThisFileDirectory)../tools/net10.0/any/Capsule.Tiled.dll')">$(MSBuildThisFileDirectory)../tools/net10.0/any/Capsule.Tiled.dll</CapsuleTiledToolAssembly>
  </PropertyGroup>

  <!-- Source mode only, where the consuming repository's Directory.Build.targets imports the
       engine ahead of this file and the property is already final. The tool rides the game's
       restore and build graph but contributes nothing to its output or publish set. -->
  <ItemGroup Condition="'$(CapsuleTiledToolProject)' != '' and '$(CapsuleImportScenes)' == 'true'">
    <ProjectReference Include="$(CapsuleTiledToolProject)"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained"
                      ExcludeAssets="all"
                      PrivateAssets="all"
                      Private="false" />
  </ItemGroup>

  <Target Name="CapsuleTiledInit"
          Condition="'$(CapsuleImportScenes)' == 'true'"
          DependsOnTargets="CapsuleAssetSourcesInit">
    <!-- Every authoring glob honours Capsule's development-only marker: a directory holding a
         .capsuleignore contributes nothing to a shipping build. @(_CapsuleDevelopmentOnly) is
         Capsule's, populated in a static item group under CapsuleShipping, so it is final by the
         time this target runs whichever order the two targets files were imported in. -->
    <ItemGroup>
      <CapsuleTiledScene Include="$(CapsuleAssetSourcesDir)/Scenes/**/*.tmj"
                         Exclude="@(_CapsuleDevelopmentOnly)" />

      <!-- Not a source of its own: a map's tilesets are read during its import, so they are the
           other half of what a derived document is up to date with respect to. -->
      <CapsuleTiledTileset Include="$(CapsuleAssetSourcesDir)/**/*.tsj"
                           Exclude="@(_CapsuleDevelopmentOnly)" />
    </ItemGroup>

    <!-- The key a map's document claims, spelled as the tree spells it: its path under the scenes
         root, forward slashes and no extension, so two maps of one stem in different directories
         are two keys. Capsule normalizes it, so this is not the shipped key and no output path is
         derived from it beyond this module's own obj/. Its own ItemGroup, and qualified:
         %(RecursiveDir) on the Include above would batch over the target rather than name the item
         being defined. -->
    <ItemGroup>
      <CapsuleTiledScene>
        <Key>$([System.String]::Copy('%(CapsuleTiledScene.RecursiveDir)').Replace('\', '/'))%(CapsuleTiledScene.Filename)</Key>
      </CapsuleTiledScene>
    </ItemGroup>

    <Error Condition="'@(CapsuleTiledScene)' != '' and '$(CapsuleTiledToolProject)' == '' and '$(CapsuleTiledToolAssembly)' == ''"
           Text="Capsule.Tiled: the Tiled importer is unavailable. Reference the JAG.Capsule.Tiled package, or import build/JAG.Capsule.Tiled.targets from a capsule-engine-tiled source clone." />

    <!-- The out directory carries no trailing separator: it is spliced into a command line, where
         a trailing one would escape the closing quote on Windows. -->
    <PropertyGroup>
      <CapsuleTiledProjectDir>$([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)'))</CapsuleTiledProjectDir>
      <CapsuleTiledObjDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'capsule-tiled'))</CapsuleTiledObjDir>
      <CapsuleTiledOutDir>$(CapsuleTiledObjDir)/scenes</CapsuleTiledOutDir>
      <CapsuleTiledDerivedDir>$(CapsuleTiledOutDir)/</CapsuleTiledDerivedDir>
      <CapsuleTiledBatchFile>$(CapsuleTiledObjDir)/scenes.txt</CapsuleTiledBatchFile>
      <CapsuleTiledTileSizeStamp>$(CapsuleTiledObjDir)/tile-size.txt</CapsuleTiledTileSizeStamp>
      <CapsuleTiledDependencyStamp>$(CapsuleTiledObjDir)/dependencies.txt</CapsuleTiledDependencyStamp>
      <CapsuleTiledDependencyRootArg>--dependency-root &quot;$(CapsuleAssetSourcesDir)&quot; </CapsuleTiledDependencyRootArg>
      <CapsuleTiledTileSizeArg Condition="'$(CapsuleTileSize)' != ''">--tile-size &quot;$(CapsuleTileSize)&quot; </CapsuleTiledTileSizeArg>
    </PropertyGroup>

    <MakeDir Directories="$(CapsuleTiledObjDir)" Condition="'@(CapsuleTiledScene)' != ''" />

    <!-- MSBuild's incrementality is file-based, so the declared size needs a file: without this
         stamp, changing CapsuleTileSize would leave documents derived under the old one current. -->
    <WriteLinesToFile Condition="'@(CapsuleTiledScene)' != ''"
                      File="$(CapsuleTiledTileSizeStamp)"
                      Lines="$(CapsuleTileSize)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <!-- A file list is itself an input. Without it, deleting or renaming a tileset removes
         that path from Inputs and can make a stale derived document appear current. -->
    <WriteLinesToFile Condition="'@(CapsuleTiledScene)' != ''"
                      File="$(CapsuleTiledDependencyStamp)"
                      Lines="@(CapsuleTiledTileset->'%(FullPath)')"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <!-- Resolved here, not where it is used: the importer is an input to every derived document,
         and a target's Inputs are evaluated after its DependsOnTargets but before its own tasks.
         RemoveProperties must match the set the ProjectReference above drops. -->
    <MSBuild Projects="$(CapsuleTiledToolProject)"
             Condition="'$(CapsuleTiledToolProject)' != '' and '@(CapsuleTiledScene)' != ''"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_CapsuleTiledTool" />
    </MSBuild>

    <ItemGroup Condition="'$(CapsuleTiledToolAssembly)' != ''">
      <_CapsuleTiledTool Include="$(CapsuleTiledToolAssembly)" />
    </ItemGroup>

    <!-- The importer is the assembly graph it loads, not its entry point: an implementation-only
         change in Capsule.Scenes rebuilds that assembly without recompiling the tool. -->
    <ItemGroup>
      <_CapsuleTiledToolAssembly Include="%(_CapsuleTiledTool.RootDir)%(_CapsuleTiledTool.Directory)*.dll" />
    </ItemGroup>
  </Target>

  <!-- Capsule's Tiled vocabulary, delivered by default: capsule.tiled-project carries the property
       types (the CapsuleCollidableFaces enum and the CapsuleLayer class) and names '.' as its
       folder, so opening it in Tiled shows the maps beside it with the types already defined.

       Seeded only where the scenes root has no .tiled-project at all, and never overwritten: the
       file is the developer's from the moment it lands, and Tiled rewrites it whenever they add a
       type or a folder of their own. A project they already keep there wins outright — import the
       types into it once from capsule-property-types.json instead. -->
  <Target Name="CapsuleTiledSeedProject"
          Condition="'$(CapsuleImportScenes)' == 'true'"
          DependsOnTargets="CapsuleTiledInit"
          BeforeTargets="CapsuleTiledDeriveSceneDocuments">

    <ItemGroup>
      <_CapsuleTiledExistingProject Include="$(CapsuleAssetSourcesDir)/Scenes/*.tiled-project" />
    </ItemGroup>

    <Copy Condition="'@(CapsuleTiledScene)' != '' and '@(_CapsuleTiledExistingProject)' == ''"
          SourceFiles="$(MSBuildThisFileDirectory)capsule.tiled-project"
          DestinationFiles="$(CapsuleAssetSourcesDir)/Scenes/$(MSBuildProjectName).tiled-project" />
  </Target>

  <!-- Partially incremental: maps correlate one-to-one with the derived documents, so MSBuild
       re-runs this with only the stale ones in @(CapsuleTiledScene) and the batch goes to one
       process. The tilesets, stamps and importer assemblies correlate with nothing, so touching
       any of them re-derives the lot. An empty Inputs skips the target outright. -->
  <Target Name="CapsuleTiledDeriveSceneDocuments"
          Condition="'$(CapsuleImportScenes)' == 'true'"
          DependsOnTargets="CapsuleTiledInit;ResolveProjectReferences"
          Inputs="@(CapsuleTiledScene);@(CapsuleTiledTileset);$(CapsuleTiledDependencyStamp);$(CapsuleTiledTileSizeStamp);@(_CapsuleTiledTool);@(_CapsuleTiledToolAssembly)"
          Outputs="@(CapsuleTiledScene->'$(CapsuleTiledDerivedDir)%(Key).scene.json')">

    <Error Condition="!Exists('@(_CapsuleTiledTool)')"
           Text="Capsule.Tiled: the Tiled importer was not built (expected '@(_CapsuleTiledTool)')." />

    <!-- The batch goes through a file, not the command line: Exec runs through cmd, whose
         8191-character limit a couple of hundred paths blow past. Each line is the key, '|', then
         the path relative to the importing project — the tool runs from there and stamps that path
         into the document's source block verbatim. A key is path segments and a path carries no
         '|' on any platform Capsule targets. -->
    <ItemGroup>
      <_CapsuleTiledSceneArg Include="@(CapsuleTiledScene)">
        <ProjectRelativePath>$([MSBuild]::MakeRelative($(CapsuleTiledProjectDir), %(FullPath)))</ProjectRelativePath>
      </_CapsuleTiledSceneArg>
    </ItemGroup>

    <WriteLinesToFile File="$(CapsuleTiledBatchFile)"
                      Lines="@(_CapsuleTiledSceneArg->'%(Key)|%(ProjectRelativePath)')"
                      Overwrite="true" />

    <!-- LogStandardErrorAsError surfaces the tool's per-source messages verbatim as build errors,
         each already anchored to the map that failed. -->
    <Exec Command="&quot;$(CapsuleDotNetHost)&quot; &quot;@(_CapsuleTiledTool)&quot; --out &quot;$(CapsuleTiledOutDir)&quot; $(CapsuleTiledDependencyRootArg)$(CapsuleTiledTileSizeArg)--scenes-from &quot;$(CapsuleTiledBatchFile)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          LogStandardErrorAsError="true"
          StandardOutputImportance="normal" />
  </Target>

  <!-- The hand-over to Capsule. Separate from the derivation so the documents are handed over on
       an up-to-date build too, where that is skipped entirely. -->
  <Target Name="CapsuleTiledCollectSceneDocuments"
          Condition="'$(CapsuleImportScenes)' == 'true'"
          DependsOnTargets="CapsuleTiledDeriveSceneDocuments"
          BeforeTargets="CapsuleCollectSceneDocuments">

    <!-- Named in two steps: %() in the metadata below batches over the item the Include names, so
         a transform there would resolve %(Key) against the derived document rather than the map. -->
    <ItemGroup>
      <_CapsuleTiledDerived Include="@(CapsuleTiledScene->'$(CapsuleTiledDerivedDir)%(Key).scene.json')" />
    </ItemGroup>

    <ItemGroup>
      <CapsuleSceneDocument Include="@(_CapsuleTiledDerived)">
        <CapsuleDocumentKey>%(_CapsuleTiledDerived.Key)</CapsuleDocumentKey>
      </CapsuleSceneDocument>
    </ItemGroup>
  </Target>

</Project>
