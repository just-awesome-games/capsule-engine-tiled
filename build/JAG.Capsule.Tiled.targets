<Project>

  <!-- A game building against this clone imports this file in place of the package, through
       Capsule's CapsuleSourceOverrides. The game's build project, the one referencing
       JAG.Capsule.Build, then compiles the importer from source. -->
  <ItemGroup Condition="'@(PackageReference->WithMetadataValue('Identity', 'JAG.Capsule.Build'))' != ''">
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/JAG.Capsule.Tiled/JAG.Capsule.Tiled.csproj" />
  </ItemGroup>

</Project>
