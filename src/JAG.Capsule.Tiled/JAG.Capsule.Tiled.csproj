<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>JAG.Capsule.Tiled</RootNamespace>
    <AssemblyName>JAG.Capsule.Tiled</AssemblyName>
    <PackageId>JAG.Capsule.Tiled</PackageId>
    <Description>Tiled (.tmj/.tsj) scene authoring for Capsule games: imports maps into Capsule scene documents at build time.</Description>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JAG.Capsule.Build" Version="[0.10.0]" />
  </ItemGroup>

  <!-- Shipped at the package root, where a developer copies the project template or imports the
       standalone types through Project > Import Types. -->
  <ItemGroup>
    <None Include="capsule.tiled-project;capsule-property-types.json" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
