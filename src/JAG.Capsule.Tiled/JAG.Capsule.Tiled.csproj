<Project Sdk="Microsoft.NET.Sdk">

  <!-- A library a game's build project references. It compiles against JAG.Capsule.Build, and
       TiledImporter is its whole public surface. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>JAG.Capsule.Tiled</RootNamespace>
    <AssemblyName>JAG.Capsule.Tiled</AssemblyName>
    <PackageId>JAG.Capsule.Tiled</PackageId>
    <Description>Tiled (.tmj/.tsj) scene authoring for Capsule games: imports maps into Capsule scene documents at build time.</Description>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JAG.Capsule.Tiled.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JAG.Capsule.Build" Version="[0.10.0]" />
  </ItemGroup>

  <!-- The importer seeds the template. A developer whose Tiled project already exists imports the
       standalone types from the package root through Project > Import Types. -->
  <ItemGroup>
    <EmbeddedResource Include="capsule.tiled-project" LogicalName="capsule.tiled-project" />
    <None Include="capsule-property-types.json" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
