<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;SelfContained;RuntimeIdentifier">

  <!-- One package holds the build targets and the process they run. The assembly ships under tools/
       and only the targets invoke it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.Tiled</RootNamespace>
    <AssemblyName>Capsule.Tiled</AssemblyName>
    <PackageId>JAG.Capsule.Tiled</PackageId>
    <Description>Tiled (.tmj/.tsj) scene authoring for Capsule games: translates maps into Capsule scene documents at build time.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeSymbols>false</IncludeSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Local through TreatAsLocalProperty. NuGet's restore walk reaches this project from a
         consumer's NativeAOT publish and would otherwise evaluate the tool for that runtime. -->
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier></RuntimeIdentifier>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeCapsuleTiledTool</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Capsule.Tiled.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(CapsuleSourceRoot)' == ''">
    <PackageReference Include="JAG.Capsule" Version="[$(CapsuleVersion)]" />
  </ItemGroup>

  <ItemGroup Condition="'$(CapsuleSourceRoot)' != ''">
    <ProjectReference Include="$(CapsuleSourceRoot)/src/Capsule.Scenes/Capsule.Scenes.csproj" />
  </ItemGroup>

  <!-- The seed target resolves the project template against its own directory. All three files
       sit together in buildTransitive/. -->
  <ItemGroup>
    <None Include="../../build/JAG.Capsule.Tiled.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="../../build/capsule.tiled-project" Pack="true" PackagePath="buildTransitive/" />
    <None Include="../../build/capsule-property-types.json" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

  <!-- The whole output directory ships. The tool resolves Capsule.Scenes and its dependencies
       without a game's package graph. -->
  <Target Name="IncludeCapsuleTiledTool">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutDir)*.dll" PackagePath="tools/net10.0/any/" />
      <TfmSpecificPackageFile Include="$(OutDir)*.json" PackagePath="tools/net10.0/any/" />
    </ItemGroup>
  </Target>

</Project>
